#!/usr/bin/env bash
# commit-msg hook — kiểm tra format commit message
# Format bắt buộc: [GiaiDoan] mo ta (toi thieu 10 ky tu)
# Loai la tuy chon:  feat | docs | fix | chore | refactor | test | wip
# Giai đoạn hợp lệ: Init | Planning | Requirements | Design | Execution | Monitoring | Closing

commit_msg_file="$1"
commit_msg=$(head -n1 "$commit_msg_file")

pattern="^\[(Init|Planning|Requirements|Design|Execution|Monitoring|Closing)\] .{10,}"

if ! echo "$commit_msg" | grep -Eq "$pattern"; then
  echo ""
  echo "Commit message khong dung chuan."
  echo ""
  echo "Dinh dang yeu cau : [GiaiDoan] mo ta (>=10 ky tu)"
  echo "Giai doan hop le  : Init | Planning | Requirements | Design | Execution | Monitoring | Closing"
  echo "Loai (tuy chon)   : feat | docs | fix | chore | refactor | test | wip"
  echo ""
  echo "Vi du hop le:"
  echo "  [Planning] docs: bo sung WBS cho giai doan lap ke hoach"
  echo "  [Init] tao khung repo va quy trinh lam viec nhom"
  echo ""
  echo "Message hien tai  : $commit_msg"
  echo ""
  exit 1
fi

exit 0